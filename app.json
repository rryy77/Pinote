{
  "expo": {
    "name": "Pinote",
    "slug": "Pinote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ryuufuji.pinote",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ryuufuji.pinote",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/icon.png",
          "imageWidth": 300
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "メモを現在地に保存するために位置情報を使用します。"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "メモを現在地に保存するために位置情報を使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "メモに添付する写真を選ぶために写真ライブラリにアクセスします。"
        }
      ],
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosAppGroupIdentifier": "group.com.ryuufuji.pinote"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.443943401482-0frkqj6k1br3p81vi7alsng36vqs1oq8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://ehiezxoqygqbchwfraqd.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVoaWV6eG9xeWdxYmNod2ZyYXFkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcyODQ5MDgsImV4cCI6MjEwMjg2MDkwOH0.LPei1o6oa0n3m3BrqwqYfDQM_4rKHHDG4CoVtHun6kc",
      "googleWebClientId": "443943401482-4dfh6mno2g06eep8mtf8crcq5qgfdqe8.apps.googleusercontent.com",
      "googleIosClientId": "443943401482-0frkqj6k1br3p81vi7alsng36vqs1oq8.apps.googleusercontent.com",
      "appleSignInEnabled": false
    }
  }
}
